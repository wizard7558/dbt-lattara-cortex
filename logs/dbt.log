    CAST(NULL AS STRING) as account_id,
    CAST(NULL AS FLOAT64) as spend,
    CAST(NULL AS INTEGER) as impressions,
    CAST(NULL AS INTEGER) as clicks
  FROM (SELECT 1) WHERE FALSE
  
),

tiktok_performance AS (
