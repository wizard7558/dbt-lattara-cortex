    OPTIONS()
    as (
      WITH
active_ads AS (
    SELECT
        ad_id
    FROM `res-analytics`.`com_allied`.`kpi_creative_daily`
    WHERE 
        latest_date = DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY) -- Always process from the last full day.
),

kpi AS (
    SELECT
    *
    FROM `res-analytics`.`com_allied`.`kpi_creative_daily`
    WHERE ad_id IN (SELECT ad_id FROM active_ads)
),

kpi_metadata AS (
    SELECT DISTINCT
        organization_id,
        product_id,
        ad_network_id,
        account_id,
        campaign_id,
        campaign_name,
        adset_id,
        adset_name,
        ad_id,
        ad_name
    FROM kpi
),

f_spend AS (
    SELECT
