    p.kpi_6_value,

    p.kpi_7_name,
    p.kpi_7_count,
    p.kpi_7_value,

    p.kpi_8_name,
    p.kpi_8_count,
    p.kpi_8_value,

    p.kpi_9_name,
    p.kpi_9_count,
    p.kpi_9_value,

    p.kpi_10_name,
    p.kpi_10_count,
    p.kpi_10_value

  FROM all_performance_with_fatigue p
  -- LEFT JOIN `res-analytics.com_allied.ads` ad
  LEFT JOIN `res-analytics`.`com_allied`.`ads` ad
    ON p.ad_id = ad.id
  -- LEFT JOIN `res-analytics.com_allied.adsets` adset
