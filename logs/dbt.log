  FROM tiktok_campaign_latest c
  INNER JOIN tiktok_account_latest a
    ON c.account_id = a.id
    AND a.rn = 1
  WHERE c.rn = 1
),

all_campaigns AS (
  SELECT
    CONCAT('facebook_ads_', CAST(id AS STRING)) AS id,
    name AS campaign_name,
    CONCAT('facebook_ads_', account_id) AS account_id,
