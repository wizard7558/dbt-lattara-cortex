  k.ad_network_id,
  c.account_id,
  c.organization_id,
  c.product_id
FROM all_keywords k
LEFT JOIN `res-analytics`.`com_allied`.`adsets` adset
  ON k.adset_id = adset.id
LEFT JOIN `res-analytics`.`com_allied`.`campaigns` c
  ON adset.campaign_id = c.id


    );
  
